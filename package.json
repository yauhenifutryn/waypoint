{
  "name": "waypoint",
  "version": "0.1.0",
  "private": true,
  "description": "Waypoint: local governance workflow for small software",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 4300",
    "build": "next build",
    "start": "next start -p 4300",
    "supervisor": "tsx src/server/supervisor/main.ts",
    "dev:all": "concurrently -n console,supervisor -c blue,magenta \"next dev --hostname 127.0.0.1 -p 4300\" \"tsx watch src/server/supervisor/main.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx e2e/smoke.ts",
    "wp": "tsx src/cli/wp.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "croner": "^9.1.0",
    "next": "^16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "type": "module"
}
